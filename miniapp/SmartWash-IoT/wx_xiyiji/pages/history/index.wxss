/* pages/history/index.wxss */
.container {
  min-height: 100vh;
  background: #f5f7fa;
  padding: 20rpx;
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  height: 400rpx;
  color: #999;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 500rpx;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 24rpx;
  margin-top: 10rpx;
  color: #ccc;
}

/* 历史记录列表 */
.history-list {
  padding-bottom: 40rpx;
}

/* 卡片样式 */
.card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.device-info {
  display: flex;
  flex-direction: column;
}

.device-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.order-no {
  font-size: 22rpx;
  color: #999;
  margin-top: 6rpx;
}

/* 状态标签 */
.status {
  font-size: 24rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.status-success {
  background: #e6f7e6;
  color: #52c41a;
}

.status-running {
  background: #fff7e6;
  color: #faad14;
}

.status-default {
  background: #f5f5f5;
  color: #999;
}

/* 卡片内容 */
.card-body {
  padding: 20rpx 24rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 10rpx 0;
}

.label {
  font-size: 26rpx;
  color: #999;
}

.value {
  font-size: 26rpx;
  color: #333;
}

/* 卡片底部 */
.card-footer {
  display: flex;
  justify-content: flex-end;
  align-items: center;
  padding: 20rpx 24rpx;
  border-top: 1rpx solid #f0f0f0;
  background: #fafafa;
}

.amount {
  font-size: 36rpx;
  font-weight: bold;
  color: #ff4d4f;
}
