/* pages/admin/devices/devices.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

.page-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  background: #fff;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

.add-btn {
  font-size: 26rpx;
  color: #fff;
  background: #1296db;
  border: none;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
}

.device-list {
  padding: 20rpx;
}

.device-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.device-info {
  padding: 30rpx;
}

.device-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.device-name-row {
  display: flex;
  align-items: center;
}

.status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 12rpx;
}

.dot-idle { background: #52c41a; }
.dot-running { background: #faad14; }
.dot-paused { background: #ff4d4f; }
.dot-finished { background: #52c41a; }
.dot-offline { background: #999; }

.device-sn {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.status-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
  color: #fff;
}

.status-badge.OFFLINE { background: #999; }
.status-badge.IDLE { background: #52c41a; }
.status-badge.RUNNING { background: #1296db; }
.status-badge.PAUSED { background: #faad14; }
.status-badge.FINISHED { background: #52c41a; }
.status-badge.FAULT { background: #ff4d4f; }

.device-name, .device-location, .device-price {
  font-size: 26rpx;
  color: #666;
  margin-top: 8rpx;
}

.label {
  color: #999;
}

.device-actions {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
  padding: 0;
  margin: 0;
}

.action-btn {
  flex: 1;
  font-size: 26rpx;
  padding: 20rpx;
  margin-top: 0;
  text-align: center;
  background: transparent;
  border: none;
  border-radius: 0 !important;
  border-right: 1rpx solid #f0f0f0;
}


.action-btn:last-child {
  border-right: none;
}

.action-btn.qrcode {
  color: #1890ff;
}

.action-btn.reset {
  color: #faad14;
}

.action-btn.delete {
  color: #ff4d4f;
}

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
  color: #999;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.empty-tip {
  font-size: 24rpx;
  margin-top: 16rpx;
}

.loading-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
}

.modal-content {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 80%;
  background: #fff;
  border-radius: 16rpx;
  z-index: 101;
}

.modal-header {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.modal-body {
  padding: 30rpx;
}

.form-item {
  margin-bottom: 24rpx;
}

.form-label {
  display: block;
  font-size: 26rpx;
  color: #666;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  padding: 20rpx;
  border: 1rpx solid #ddd;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.modal-footer {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.modal-btn {
  flex: 1;
  padding: 24rpx;
  font-size: 28rpx;
  text-align: center;
  background: none;
  border: none;
  border-radius: 0;
}

.modal-btn.cancel {
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.modal-btn.confirm {
  color: #1296db;
}

/* 二维码弹窗 */
.qr-modal {
  position: fixed;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 85%;
  background: #fff;
  border-radius: 20rpx;
  z-index: 101;
  overflow: hidden;
}

.qr-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.qr-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.qr-close {
  font-size: 48rpx;
  color: #999;
  line-height: 1;
}

.qr-body {
  padding: 40rpx;
  text-align: center;
}

.qr-image-container {
  width: 400rpx;
  height: 400rpx;
  margin: 0 auto 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #fafafa;
  border-radius: 16rpx;
}

.qr-image {
  width: 100%;
  height: 100%;
}

.qr-loading {
  color: #999;
  font-size: 28rpx;
}

.qr-info {
  margin-top: 20rpx;
}

.qr-device-sn {
  font-size: 36rpx;
  font-weight: bold;
  color: #1890ff;
  margin-bottom: 10rpx;
}

.qr-tip {
  font-size: 26rpx;
  color: #999;
}

.qr-actions {
  display: flex;
  border-top: 1rpx solid #f0f0f0;
}

.qr-btn {
  flex: 1;
  padding: 28rpx;
  font-size: 28rpx;
  text-align: center;
  background: none;
  border: none;
  border-radius: 0;
}

.qr-btn.copy {
  color: #666;
  border-right: 1rpx solid #f0f0f0;
}

.qr-btn.save {
  color: #1890ff;
}
