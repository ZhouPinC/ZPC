<!--pages/admin/devices/devices.wxml-->
<view class="page-container">
  <view class="page-header">
    <text class="page-title">设备管理</text>
    <button class="add-btn" bindtap="showAddDevice">+ 添加设备</button>
  </view>

  <view class="device-list" wx:if="{{!loading}}">
    <view wx:for="{{devices}}" wx:key="id" class="device-card">
      <view class="device-info" bindtap="viewDevice" data-id="{{item.id}}">
        <view class="device-header">
          <view class="device-name-row">
            <view class="status-dot {{item.status === 'RUNNING' ? 'dot-running' : (item.status === 'IDLE' ? 'dot-idle' : (item.status === 'PAUSED' ? 'dot-paused' : (item.status === 'FINISHED' ? 'dot-finished' : 'dot-offline')))}}"></view>
            <text class="device-sn">{{item.deviceSn}}</text>
          </view>
          <view class="status-badge {{item.status}}">{{item.statusText || '未知'}}</view>
        </view>
        <view class="device-name" wx:if="{{item.name}}">
          <text class="label">名称：</text>
          <text>{{item.name}}</text>
        </view>
        <view class="device-location">
          <text class="label">位置：</text>
          <text>{{item.location || '未设置'}}</text>
        </view>
        <view class="device-price" wx:if="{{item.pricePerUse}}">
          <text class="label">单价：</text>
          <text>¥{{item.pricePerUse}}/次</text>
        </view>
      </view>
      <view class="device-actions">
        <button class="action-btn qrcode" bindtap="showQrCode" data-sn="{{item.deviceSn}}">二维码</button>
        <button class="action-btn reset" catchtap="resetDevice" data-sn="{{item.deviceSn}}">重置</button>
        <button class="action-btn delete" catchtap="deleteDevice" 
                data-id="{{item.id}}" data-sn="{{item.deviceSn}}">删除</button>
      </view>
    </view>

    <view wx:if="{{devices.length === 0}}" class="empty-state">
      <text class="empty-icon">📱</text>
      <text>暂无设备</text>
      <text class="empty-tip">点击右上角添加设备</text>
    </view>
  </view>

  <view wx:if="{{loading}}" class="loading-state">
    <text>加载中...</text>
  </view>

  <!-- 添加设备弹窗 -->
  <view class="modal-mask" wx:if="{{showAddModal}}" bindtap="hideAddModal"></view>
  <view class="modal-content" wx:if="{{showAddModal}}">
    <view class="modal-header">
      <text class="modal-title">添加设备</text>
    </view>
    <view class="modal-body">
      <view class="form-item">
        <text class="form-label">设备编号 *</text>
        <input class="form-input" placeholder="请输入设备编号，如 WASH_001" 
               value="{{newDevice.deviceSn}}" bindinput="onInputDeviceSn"/>
      </view>
      <view class="form-item">
        <text class="form-label">设备名称</text>
        <input class="form-input" placeholder="请输入设备名称（可选）" 
               value="{{newDevice.name}}" bindinput="onInputDeviceName"/>
      </view>
      <view class="form-item">
        <text class="form-label">设备位置</text>
        <input class="form-input" placeholder="请输入设备位置（可选）" 
               value="{{newDevice.location}}" bindinput="onInputLocation"/>
      </view>
    </view>
    <view class="modal-footer">
      <button class="modal-btn cancel" bindtap="hideAddModal">取消</button>
      <button class="modal-btn confirm" bindtap="confirmAddDevice">确定</button>
    </view>
  </view>

  <!-- 二维码弹窗 -->
  <view class="modal-mask" wx:if="{{showQrModal}}" bindtap="hideQrModal"></view>
  <view class="qr-modal" wx:if="{{showQrModal}}">
    <view class="qr-header">
      <text class="qr-title">设备绑定二维码</text>
      <text class="qr-close" bindtap="hideQrModal">×</text>
    </view>
    <view class="qr-body">
      <!-- 二维码图片显示 -->
      <view class="qr-image-container">
        <image wx:if="{{qrImagePath}}" class="qr-image" src="{{qrImagePath}}" mode="aspectFit"></image>
        <view wx:else class="qr-loading">
          <text>生成中...</text>
        </view>
      </view>
      
      <view class="qr-info">
        <view class="qr-device-sn">{{qrDeviceSn}}</view>
        <view class="qr-tip">用户扫描此二维码即可绑定设备</view>
      </view>
    </view>
    <view class="qr-actions">
      <button class="qr-btn copy" bindtap="copyQrContent">复制内容</button>
      <button class="qr-btn save" bindtap="saveQrCode">保存图片</button>
    </view>
    
    <!-- Canvas 用于生成二维码 -->
    <canvas type="2d" id="qrCanvas" style="width: 400px; height: 500px; position: fixed; left: -9999px;"></canvas>
    <canvas canvas-id="qrCanvasLegacy" style="width: 300px; height: 380px; position: fixed; left: -9999px;"></canvas>
  </view>
</view>
