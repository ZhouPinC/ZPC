/* pages/admin/users/users.wxss */
.page-container {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 40rpx;
}

.page-header {
  padding: 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.page-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  display: block;
}

.page-subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}

.user-list {
  padding: 0 20rpx;
}

.user-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
}

.user-header {
  display: flex;
  align-items: center;
  padding: 30rpx;
}

.user-avatar {
  width: 90rpx;
  height: 90rpx;
  border-radius: 50%;
  margin-right: 24rpx;
  flex-shrink: 0;
  background: #f0f0f0;
}

.user-info {
  flex: 1;
  min-width: 0;
}

.user-title {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 12rpx;
}

.user-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

.user-phone {
  font-size: 24rpx;
  color: #1890ff;
  background: #e6f7ff;
  padding: 4rpx 12rpx;
  border-radius: 4rpx;
}

.user-meta {
  display: flex;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #666;
  gap: 24rpx;
}

.expand-icon {
  font-size: 24rpx;
  color: #999;
  transition: transform 0.3s;
}

.expand-icon.expanded {
  transform: rotate(180deg);
}

/* 设备列表 */
.device-list-section {
  border-top: 1rpx solid #f0f0f0;
  padding: 20rpx 30rpx;
  background: #fafafa;
}

.no-device {
  text-align: center;
  padding: 30rpx 0;
  color: #999;
  font-size: 26rpx;
}

.device-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.device-item:last-child {
  border-bottom: none;
}

.device-info-row {
  display: flex;
  align-items: center;
  flex: 1;
}

.device-status-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.dot-idle {
  background: #52c41a;
}

.dot-running {
  background: #faad14;
}

.dot-offline {
  background: #999;
}

.device-detail {
  display: flex;
  flex-direction: column;
}

.device-sn {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.device-name {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}

.unbind-btn {
  font-size: 24rpx;
  color: #ff4d4f;
  background: #fff;
  border: 1rpx solid #ff4d4f;
  border-radius: 8rpx;
  padding: 8rpx 24rpx;
  line-height: 1.5;
}

.unbind-btn:active {
  background: #fff1f0;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 100rpx 0;
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #999;
  font-size: 28rpx;
}

.loading-state {
  text-align: center;
  padding: 100rpx 0;
  color: #999;
}
