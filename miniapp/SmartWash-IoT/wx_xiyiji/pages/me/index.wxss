page { background-color: #f5f7fa; }

/* 容器 */
.container {
  min-height: 100vh;
  background-color: #f5f7fa;
  padding: 0;
  margin: 0;
  padding-top: 20rpx;
}

/* 头部卡片 - 渐变蓝背景，设置内边距和阴影效果 */
.header-card {
  background: linear-gradient(135deg, #1296db 0%, #6ec6ff 100%);
  padding: 40rpx 20rpx 30rpx 20rpx;
  margin: 0 20rpx;
  color: white;
  box-shadow: 0 2rpx 10rpx rgba(18, 150, 219, 0.15);
  border-radius: 12rpx;
  cursor: pointer;
  position: relative;
  display: flex;
  align-items: center;
}

/* 头部内容容器 - Flex布局，居中对齐，调整间距和边距 */
.header-content {
  display: flex;
  align-items: center; /* 垂直居中对齐 */
  gap: 30rpx; /* 头像与用户信息之间的间距 */
  max-width: 750rpx; /* 最大宽度，适配不同屏幕 */
  margin: 0 auto; /* 水平居中 */
  padding: 0 20rpx; /* 左右内边距，避免内容紧贴边缘 */
  flex: 1; /* 占据剩余空间 */
}

/* 头像区域 - 垂直排列，固定宽度 */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  width: 140rpx; /* 固定最小宽度，确保头像区域稳定 */
  height: 176rpx;
}

/* 头像包装容器 - 相对定位，用于放置编辑图标 */
.avatar-wrapper {
  position: relative;
  width: 140rpx;
  height: 140rpx;
  display: flex;
}

/* 头像按钮 - 自定义样式，去除默认按钮样式 */
.avatar-btn {
  padding: 0;
  margin-top: 0;
  background: transparent;
  border: none;
  line-height: normal;
  width: 140rpx;
  height: 142rpx;
  border-radius: 50%; /* 圆形头像 */
  overflow: hidden;
}

/* 去除按钮默认伪元素 */
.avatar-btn::after {
  border: none;
}

/* 头像图片 - 圆形显示，添加边框 */
.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%; /* 圆形头像 */
  background-color: #e0e0e0; /* 默认背景色 */
}


/* 头像编辑图标 - 右下角小图标 */
.edit-icon {
  position: absolute;
  bottom: 0; /* 底部对齐 */
  right: 0; /* 右侧对齐 */
  background: rgba(0,0,0,0.5); /* 半透明黑色背景 */
  color: white;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
}

/* 登录提示文字 - 未登录状态显示 */
.login-hint {
  font-size: 22rpx;
  color: rgba(255,255,255,0.9);
  margin-top: 10rpx;
  text-align: center;
}

/* 用户信息区域 - 弹性布局，占据剩余空间 */
.user-info-section {
  flex: 1; /* 占据剩余空间 */
  display: flex;
  flex-direction: column;
  justify-content: center;
  height: 170rpx; /* 最小高度，确保与头像区域对齐 */
}

.login-desc {
  padding-left: 80rpx;
  text-align: left;
  padding-bottom: 24rpx;
}

/* 用户信息容器 - 垂直排列，设置间距 */
.user-infom {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 10rpx;
  padding-bottom: 24rpx;
}

.profile-loading {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 6rpx;
}

.profile-error {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.95);
  margin-top: 6rpx;
  text-decoration: underline;
}

.user-infoms {
  display: flex;
  flex-direction: row;
}

/* 用户主要信息 - 昵称区域 */
.user-main-info {
  display: flex;
  flex-wrap: wrap; /* 支持换行，适配小屏幕 */
}

/* 昵称输入框 - 自定义样式 */
.nickname-input {
  font-size: 34rpx;
  font-weight: bold;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 8rpx;
  padding: 8rpx 16rpx;
  min-width: 200rpx;
}

/* 箭头标识 */
.arrow-icon {
  font-size: 36rpx;
  color: rgba(255, 255, 255, 0.7);
  margin-left: 16rpx;
  flex-shrink: 0;
  padding: 10rpx; /* 增加点击区域 */
}

/* 编辑按钮 - 明确的跳转入口 */
.edit-btn {
  background: rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 30rpx;
  padding: 10rpx 24rpx;
  margin-right: 10rpx;
  flex-shrink: 0;
  transition: background-color 0.2s ease;
}

.edit-btn text {
  font-size: 24rpx;
  color: #ffffff;
}

.edit-btn:active {
  background: rgba(255, 255, 255, 0.3);
}

/* 用户标签容器 - 水平排列，支持换行 */
.user-tags {
  flex-wrap: wrap;
  gap: 12rpx; /* 调整标签间距 */
  display: flex;
  flex-direction: row;
}

.tag {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
  font-weight: 400;
}

.phone-tag {
  background: rgba(255,255,255,0.2);
  color: #fff;
}

.vip-tag {
  height: 24rpx;
  margin-left: 30rpx;
  background: linear-gradient(135deg, #FFD700 0%, #FFA500 100%);
  color: #333;
  font-weight: bolder;
  align-self: center;
}

.bind-phone-btn {
  color: #ffffff;
  font-size: 22rpx;
  padding: 4rpx 5rpx;
  border-radius: 20rpx;
  border: none;
  line-height: 1.5;
  font-weight: normal;
}

.bind-phone-btn::after {
  border: none;
}

/* 登录提示 */
.nickname-placeholder {
  color: rgba(255,255,255,0.9);
  font-size: 32rpx;
  font-weight: bold;
  min-width: 180rpx;
  max-width: 350rpx;
  padding: 10rpx 0;
}

/* 统计卡片 */
.stats-card {
  background: white;
  margin: 16rpx 20rpx;
  padding: 24rpx 0;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}


.stats-content {
  display: flex;
  justify-content: space-around;
  align-items: center;
  max-width: 750rpx;
  margin: 0 auto;
  width: 100%;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 0 16rpx;
  min-height: 80rpx;
  justify-content: center;
}

.stat-value {
  font-size: 34rpx;
  font-weight: bold;
  color: #333;
}

.stat-label {
  font-size: 22rpx;
  color: #999;
  text-align: center;
}

/* 菜单列表 */
.menu-list {
  background: white;
  border-radius: 12rpx;
  margin: 0 20rpx 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
}

.menu-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 28rpx 30rpx;
  border-bottom: 1rpx solid #f5f5f5;
  transition: background-color 0.2s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background-color: #fafafa;
}

.menu-item .left {
  display: flex;
  align-items: center;
  gap: 18rpx;
  flex: 1;
}

.menu-icon {
  width: 44rpx;
  height: 44rpx;
  object-fit: contain;
}

.menu-item .left text {
  font-size: 28rpx;
  color: #333;
  font-weight: 400;
  flex: 1;
}

.text-gray {
  color: #ccc;
  font-family: monospace;
  font-size: 30rpx;
  flex-shrink: 0;
}

/* 管理入口 */
.admin-entry {
  background: linear-gradient(135deg, #f5f7fa 0%, #fff 100%);
  margin: 10rpx 20rpx;
  border-radius: 12rpx;
  box-shadow: 0 2rpx 10rpx rgba(18, 150, 219, 0.1);
  border: 1rpx solid rgba(18, 150, 219, 0.1);
}

.admin-entry .left text {
  color: #1296db;
  font-weight: 500;
}

.admin-badge {
  background: #1296db;
  color: #fff;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
  margin-right: 10rpx;
}

/* 退出按钮 */
.footer {
  padding: 30rpx;
  margin-top: 40rpx;
}

.btn-logout {
  background: white;
  color: #ff4d4f;
  border: 1rpx solid #ffeded;
  border-radius: 12rpx;
  padding: 24rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 2rpx 10rpx rgba(255, 77, 79, 0.1);
}

.btn-logout::after {
  border: none;
}

.btn-logout:active {
  background-color: #fff5f5;
}
