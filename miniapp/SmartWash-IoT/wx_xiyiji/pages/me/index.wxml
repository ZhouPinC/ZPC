<view class="container">
  
  <!-- 头部卡片 -->
  <view class="header-card">
    <view class="header-content" bindtap="navigateToProfile" data-user="{{userInfo}}">
      <!-- 头像区域 - 移除编辑交互，仅展示 -->
      <view class="avatar-section">
        <view class="avatar-wrapper">
          <image class="avatar" src="{{avatarDisplayUrl}}" mode="aspectFill" binderror="onAvatarError"></image>
        </view>
        <view class="login-hint" wx:if="{{!userInfo}}">未登录</view>
      </view>
      
      <!-- 用户信息区域 - 移除编辑交互，仅展示 -->
      <view class="user-info-section">
        <view class="user-infom" wx:if="{{userInfo}}">
          <view class="user-infoms">
            <view class="user-main-info">
              <!-- 昵称仅展示，不编辑 -->
              <view class="nickname-display">{{userInfo.nickName || '微信用户'}}</view>
            </view>
              <view class="tag vip-tag">黄金会员</view>
          </view>
          <view class="profile-loading" wx:if="{{profileState === 'loading'}}">加载中...</view>
          <view class="profile-error" wx:if="{{profileState === 'error'}}" bindtap="retryLoad">{{profileError}}</view>
          <view class="user-tags">
            <view class="tag phone-tag" wx:if="{{userInfo.phone}}">📱 {{userInfo.phone}}</view>
            <view wx:else class="tag bind-phone-btn" catchtap="bindPhone">
              📱 点击绑定手机号
            </view>
          </view>  
        </view>
        <view class="login-prompt" wx:if="{{!userInfo}}" bindtap="handleLogin">
          <view class="login-desc">请登录账号</view>
        </view>
      </view>
    </view>
    
    <!-- 编辑按钮 - 明确的可点击入口 -->
    <view class="edit-btn" wx:if="{{userInfo}}" bindtap="navigateToProfile">
      <text>编辑</text>
    </view>
    
    <!-- 箭头标识 - 提示可点击 -->
    <view class="arrow-icon" wx:if="{{userInfo}}" catchtap="navigateToProfile">></view>
  </view>

  <!-- 统计栏 -->
  <view class="stats-card" wx:if="{{userInfo}}">
    <view class="stats-content">
      <view class="stat-item">
        <view class="stat-value">¥{{userInfo.balance || '0.00'}}</view>
        <view class="stat-label">余额</view>
      </view>
      <view class="stat-item">
        <view class="stat-value">{{userInfo.points || 0}}</view>
        <view class="stat-label">积分</view>
      </view>
      <view class="stat-item" bindtap="navigateToBind">
        <view class="stat-value">{{boundDeviceCount || 0}}</view>
        <view class="stat-label">我的设备</view>
      </view>
    </view>
  </view>


  <view class="menu-list">
    
    <view class="menu-item" bindtap="navigateToHistory">
      <view class="left">
        <image class="menu-icon" src="/images/icon_history.png" binderror="handleImageError" data-type="menu"></image>
        <text>洗衣记录</text>
      </view>
      <view class="right text-gray">></view>
    </view>

    <view class="menu-item" bindtap="navigateToBind">
      <view class="left">
        <image class="menu-icon" src="/images/icon_device.png" binderror="handleImageError" data-type="menu"></image>
        <text>设备管理</text>
      </view>
      <view class="right text-gray">></view>
    </view>

    <view class="menu-item">
      <view class="left">
        <image class="menu-icon" src="/images/icon_help.png" binderror="handleImageError" data-type="menu"></image>
        <text>使用帮助</text>
      </view>
      <view class="right text-gray">></view>
    </view>

    <view class="menu-item">
      <view class="left">
        <image class="menu-icon" src="/images/icon_settings.png" binderror="handleImageError" data-type="menu"></image>
        <text>设置</text>
      </view>
      <view class="right text-gray">></view>
    </view>

    <!-- 管理入口 -->
    <view class="menu-item admin-entry" wx:if="{{userInfo}}" bindtap="{{isAdmin ? 'goToAdmin' : 'enterAdminMode'}}">
      <view class="left">
        <image class="menu-icon" src="/images/icon_settings.png" binderror="handleImageError" data-type="menu"></image>
        <text>{{isAdmin ? '管理中心' : '进入管理模式'}}</text>
      </view>
      <view class="right">
        <text class="admin-badge" wx:if="{{isAdmin}}">管理员</text>
        <text class="text-gray">></text>
      </view>
    </view>
  </view>

  <view class="footer" wx:if="{{userInfo}}">
    <button class="btn-logout" bindtap="handleLogout">退出登录</button>
  </view>

</view>
