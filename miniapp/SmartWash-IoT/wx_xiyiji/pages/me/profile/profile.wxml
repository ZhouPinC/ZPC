<view class="profile-container">
  <view class="section-card">
    <view class="section-title">基本信息</view>
    
    <view class="form-item avatar-form-item">
      <view class="form-label">头像</view>
      <view class="avatar-upload-section">
        <button class="avatar-upload-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
          <image class="avatar-preview" src="{{avatarUrl || '/images/me.png'}}" mode="aspectFill"></image>
          <view class="avatar-mask" wx:if="{{avatarUploading || avatarLoading}}">
            <view class="avatar-spinner"></view>
          </view>
        </button>
      </view>
    </view>

    <view class="form-item">
      <view class="form-label">昵称</view>
      <input 
        class="form-input" 
        type="nickname" 
        placeholder="请输入昵称" 
        value="{{nickName}}" 
        bindinput="onNickNameInput"
        confirm-type="done"
      />
    </view>

    <view class="form-sex form-item">
      <view class="form-label">性别</view>
      <picker bindchange="onGenderChange" value="{{genderIndex}}" range="{{genderOptions}}">
        <view class="picker-value">
          {{genderOptions[genderIndex] || '请选择'}}
          <text class="picker-arrow">></text>
        </view>
      </picker>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">联系方式（可选）</view>
    
    <view class="form-item">
      <view class="form-label">手机号</view>
      <view class="phone-section">
        <view class="phone-display" wx:if="{{phone}}">
          <text class="phone-number">{{phone}}</text>
          <text class="phone-badge">已绑定</text>
        </view>
        <button 
          wx:else 
          class="bind-phone-btn" 
          open-type="getPhoneNumber" 
          bindgetphonenumber="onGetPhoneNumber"
        >
          📱 点击授权手机号
        </button>
      </view>
    </view>
  </view>

  <view class="section-card">
    <view class="section-title">账号信息</view>
    <view class="account-info">
      <view class="info-row">
        <text class="info-label">用户ID</text>
        <text class="info-value">{{userIdentifier || '暂无'}}</text>
      </view>
      <view class="info-row">
        <text class="info-label">注册时间</text>
        <text class="info-value">{{createTime || '暂无'}}</text>
      </view>
    </view>
  </view>

  <view class="save-section">
    <button class="save-btn" bindtap="saveProfile" loading="{{saving}}">保存修改</button>
  </view>

</view>
