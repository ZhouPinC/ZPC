.profile-container {
  min-height: 80vh;
  background-color: #f5f5f5;
  padding: 20rpx;
  padding-bottom: 200rpx;
}

.section-card {
  background-color: #ffffff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  padding: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #eeeeee;
}

.avatar-form-item {
  padding: 10rpx 0;
}

.avatar-upload-section {
  width: 120rpx;
  display: flex;
  align-items: center;
}

.avatar-upload-btn {
  position: relative;
  width: 100rpx;
  height: 110rpx;
  padding: 5rpx;
  margin: 0;
  background: transparent;
  border: none;
  line-height: normal;
}

.avatar-upload-btn::after {
  display: none;
}

.avatar-preview {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 2rpx solid #1296db;
}

.avatar-mask {
  position: absolute;
  top: 5rpx;
  left: 5rpx;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  background-color: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
}

.avatar-mask text {
  color: #ffffff;
  font-size: 24rpx;
}

.avatar-spinner {
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.35);
  border-top-color: rgba(255, 255, 255, 0.95);
  animation: avatarSpin 0.9s linear infinite;
}

@keyframes avatarSpin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.form-sex {
  margin-top: 24rpx;
}

.form-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12rpx 12rpx 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.form-item:last-child {
  margin-top: 24rpx;
  border-bottom: none;
}

.form-label {
  font-size: 28rpx;
  color: #333333;
  flex-shrink: 0;
}

.form-input {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #666666;
  padding-right: 0;
  margin-left: 20rpx;
  border: none;
  outline: none;
  background: transparent;
}

.form-input:focus {
  outline: none;
}

.picker-value {
  flex: 1;
  text-align: right;
  font-size: 28rpx;
  color: #666666;
  margin-left: 20rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.picker-arrow {
  margin-left: 10rpx;
  color: #999999;
}

.phone-section {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-left: 20rpx;
}

.phone-display {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.phone-number {
  font-size: 28rpx;
  color: #666666;
}

.phone-badge {
  font-size: 22rpx;
  color: #1296db;
  background-color: rgba(18, 150, 219, 0.1);
  padding: 4rpx 12rpx;
  border-radius: 20rpx;
}

.bind-phone-btn {
  font-size: 28rpx;
  color: #1296db;
  background-color: rgba(18, 150, 219, 0.1);
  border: 2rpx solid #1296db;
  border-radius: 40rpx;
  padding: 12rpx 32rpx;
  margin: 0;
  line-height: 1.5;
}

.bind-phone-btn::after {
  display: none;
}

.account-info {
  padding: 10rpx 0;
}

.info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

.info-row:not(:last-child) {
  border-bottom: 1rpx solid #f0f0f0;
}

.info-label {
  font-size: 28rpx;
  color: #666666;
}

.info-value {
  font-size: 28rpx;
  color: #333333;
}

.save-section {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  padding-bottom: calc(30rpx + env(safe-area-inset-bottom));
  background-color: transparent;

}

.save-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #1296db 0%, #6ec6ff 100%);
  color: #ffffff;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 44rpx;
  border: none;
  text-align: center;
  padding: 0;
  margin: 0;
}

.save-btn:active {
  opacity: 0.85;
}

.save-btn[loading] {
  opacity: 0.7;
}

.save-btn::after {
  display: none;
}

@media (prefers-color-scheme: dark) {
  .profile-container {
    background-color: #1a1a1a;
  }

  .section-card {
    background-color: #2d2d2d;
    box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.3);
  }

  .section-title {
    color: #ffffff;
    border-bottom-color: #404040;
  }

  .form-item {
    border-bottom-color: #404040;
  }

  .form-label {
    color: #ffffff;
  }

  .form-input {
    color: #cccccc;
  }

  .picker-value {
    color: #cccccc;
  }

  .phone-number {
    color: #cccccc;
  }

  .info-label {
    color: #999999;
  }

  .info-value {
    color: #ffffff;
  }

  .info-row:not(:last-child) {
    border-bottom-color: #404040;
  }

  .save-section {
    background-color: #2d2d2d;
  }

}
