/* pages/common/login/login.wxss */
.login-container {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-height: 100vh;
  background: linear-gradient(180deg, #f5f7fa 0%, #ffffff 100%);
  padding: 0 40rpx;
}

/* Logo区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 120rpx;
}

.logo {
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 20rpx rgba(0, 0, 0, 0.1);
}

.app-name {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 16rpx;
}

.app-desc {
  font-size: 28rpx;
  color: #999;
}

/* 登录说明区域 */
.login-tips {
  width: 100%;
  margin-top: 60rpx;
  background-color: #f8f9fa;
  border-radius: 16rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.05);
}

.tip-item {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-icon {
  font-size: 32rpx;
  margin-right: 20rpx;
  width: 40rpx;
  text-align: center;
}

.tip-text {
  font-size: 28rpx;
  color: #666;
}

/* 登录按钮区域 */
.login-section {
  width: 100%;
  margin-top: 60rpx;
}

.login-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
  transition: all 0.3s ease;
}

.wx-login-btn {
  background: linear-gradient(135deg, #07c160 0%, #06ad56 100%);
  color: #fff;
  border: none;
}

.wx-login-btn::after {
  border: none;
}

.wx-login-btn[disabled] {
  background: #ccc;
  color: #fff;
  box-shadow: none;
}

/* 登录提示 */
.login-hint {
  margin-top: 30rpx;
  text-align: center;
  font-size: 24rpx;
  color: #999;
  line-height: 1.5;
}

/* 帮助区域 */
.help-section {
  margin-top: 40rpx;
  text-align: center;
}

.help-text {
  font-size: 28rpx;
  color: #999;
  margin-right: 10rpx;
}

.help-link {
  font-size: 28rpx;
  color: #1296db;
  text-decoration: underline;
}

/* 协议链接 */
.agreement-link {
  font-size: 24rpx;
  color: #1296db;
}
