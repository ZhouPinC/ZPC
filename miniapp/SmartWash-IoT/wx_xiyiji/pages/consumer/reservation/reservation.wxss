/* pages/consumer/reservation/reservation.wxss */
.reservation-page {
  min-height: 100vh;
  background: #f5f7fa;
  padding-bottom: 120rpx;
}

/* 设备信息 */
.device-info {
  background: linear-gradient(135deg, #1296db 0%, #0d7ab8 100%);
  padding: 40rpx 30rpx;
  color: #fff;
}

.device-sn {
  font-size: 36rpx;
  font-weight: bold;
  display: block;
}

.device-location {
  font-size: 26rpx;
  opacity: 0.8;
  margin-top: 10rpx;
  display: block;
}

/* 区块 */
.section {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #333;
  margin-bottom: 20rpx;
}

/* 日期列表 */
.date-list {
  white-space: nowrap;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx;
  margin-right: 20rpx;
  border-radius: 12rpx;
  background: #f5f7fa;
}

.date-item.selected {
  background: #1296db;
  color: #fff;
}

.date-day {
  font-size: 24rpx;
}

.date-display {
  font-size: 28rpx;
  font-weight: 500;
  margin-top: 8rpx;
}

/* 时段网格 */
.slot-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.slot-item {
  width: calc(33.33% - 14rpx);
  padding: 24rpx 0;
  text-align: center;
  background: #f5f7fa;
  border-radius: 12rpx;
  border: 2rpx solid transparent;
}

.slot-item.selected {
  background: #e6f4ff;
  border-color: #1296db;
}

.slot-item.disabled {
  background: #f0f0f0;
  color: #ccc;
}

.slot-time {
  font-size: 26rpx;
  display: block;
}

.slot-status {
  font-size: 20rpx;
  color: #999;
  margin-top: 6rpx;
  display: block;
}

/* 加载和空状态 */
.loading-tip,
.empty-tip {
  text-align: center;
  padding: 60rpx 0;
  color: #999;
  font-size: 28rpx;
}

/* 确认区域 */
.confirm-section {
  background: #fff;
  margin: 20rpx;
  padding: 30rpx;
  border-radius: 16rpx;
}

.confirm-row {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.confirm-row:last-child {
  border-bottom: none;
}

.confirm-row .label {
  color: #666;
  font-size: 28rpx;
}

.confirm-row .value {
  color: #333;
  font-size: 28rpx;
  font-weight: 500;
}

/* 底部按钮 */
.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 20rpx 30rpx;
  background: #fff;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #1296db 0%, #0d7ab8 100%);
  color: #fff;
  font-size: 32rpx;
  border-radius: 44rpx;
  border: none;
}

.submit-btn.disabled {
  background: #ccc;
}

.submit-btn::after {
  border: none;
}
