/* pages/add/index.wxss - 扫码页面样式 */
.scan-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #1296db 0%, #0d7ab8 54%, #f5f5f5 54%);
  padding-bottom: 120rpx;
}

.top-decoration {
  height: 30rpx;
}

/* 扫码区域 */
.scan-area {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx 0;
  position: relative;
}

.scan-frame {
  width: 360rpx;
  height: 360rpx;
  position: relative;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 20rpx;
}

.corner {
  position: absolute;
  width: 40rpx;
  height: 40rpx;
  border-color: #fff;
  border-style: solid;
}

.top-left {
  top: 0;
  left: 0;
  border-width: 6rpx 0 0 6rpx;
  border-radius: 10rpx 0 0 0;
}

.top-right {
  top: 0;
  right: 0;
  border-width: 6rpx 6rpx 0 0;
  border-radius: 0 10rpx 0 0;
}

.bottom-left {
  bottom: 0;
  left: 0;
  border-width: 0 0 6rpx 6rpx;
  border-radius: 0 0 0 10rpx;
}

.bottom-right {
  bottom: 0;
  right: 0;
  border-width: 0 6rpx 6rpx 0;
  border-radius: 0 0 10rpx 0;
}

.scan-line {
  position: absolute;
  top: 20rpx;
  left: 20rpx;
  right: 20rpx;
  height: 4rpx;
  background: linear-gradient(90deg, transparent, #52c41a, transparent);
  animation: scanMove 2s linear infinite;
}

@keyframes scanMove {
  0% { top: 20rpx; }
  50% { top: 360rpx; }
  100% { top: 20rpx; }
}

.scan-icon-wrapper {
  position: absolute;
  width: 160rpx;
  height: 160rpx;
  background: rgba(255, 255, 255, 0.95);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.2);
}

.scan-icon {
  width: 80rpx;
  height: 80rpx;
}

/* 提示文字 */
.scan-tips {
  text-align: center;
  padding: 30rpx 0;
  color: #fff;
}

.tip-title {
  display: block;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
}

.tip-desc {
  display: block;
  font-size: 26rpx;
  opacity: 0.8;
}

/* 扫码按钮 */
.scan-btn-wrapper {
  padding: 0 60rpx;
  margin-top: 30rpx;
}

.scan-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #52c41a 0%, #73d13d 100%);
  color: #fff;
  border: none;
  border-radius: 50rpx;
  padding: 30rpx 0;
  font-size: 32rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 20rpx rgba(82, 196, 26, 0.4);
}

.scan-btn.scanning {
  background: #ccc;
  box-shadow: none;
}

.scan-btn:active:not(.scanning) {
  transform: scale(0.98);
}

.btn-icon {
  font-size: 40rpx;
  margin-right: 16rpx;
}

.btn-text {
  font-size: 32rpx;
}

/* 手动输入 */
.manual-input {
  text-align: center;
  font-weight: bolder;
  padding: 30rpx;
  color: #ffffff;
  font-size: 28rpx;
}

.manual-input:active {
  opacity: 0.7;
}

/* 使用说明 */
.usage-guide {
  margin: 40rpx 30rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

.guide-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.guide-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
}

.guide-num {
  width: 44rpx;
  height: 44rpx;
  background: linear-gradient(135deg, #1296db 0%, #0d7ab8 100%);
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.guide-text {
  font-size: 28rpx;
  color: #666;
}
