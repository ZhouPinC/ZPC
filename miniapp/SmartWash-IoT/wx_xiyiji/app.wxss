/* app.wxss */
.container {
  padding: 20px;
  background-color: #f5f5f5;
  min-height: 100vh;
  box-sizing: border-box;
}

/* 全局按钮样式 */
button {
  border-radius: 25px !important;
  margin-top: 20px;
}

/* 全局输入框样式 */
input {
  width: 100%;
  height: 48px;
  padding: 0 15px;
  border: 1px solid #ddd;
  border-radius: 8px;
  box-sizing: border-box;
  font-size: 16px;
  background-color: white;
}
